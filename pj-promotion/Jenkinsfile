pipeline {
    agent any

    tools {
        maven 'Maven 3.9.10'
        jdk 'JDK 11'
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        APP_NAME = 'pj-promotion'
        APP_PORT = '8086'
        REMOTE_HOST = 'root@118.178.172.169'
        REMOTE_DIR = '/opt/developments'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '3'))
    }

    stages {
        stage('checkout') {
            steps {
                echo '拉取代码...'
                git url: 'git@github.com:pajamas-pj/study-in-pajamas.git', branch: 'master'
            }
        }

        stage('build') {
            steps {
                echo "开始构建 ${APP_NAME} ..."
                sh "mvn clean package -pl ${APP_NAME} -am -T 1C -Dmaven.test.skip=true -nsu"
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def appPort = "${APP_PORT}" // 默认取环境变量里的 10011
                    def ymlFile = "${APP_NAME}/src/main/resources/bootstrap.yml"

                    // 检查文件是否存在
                    if (fileExists(ymlFile)) {
                        def config = readYaml file: ymlFile
                        // 读取 server.port，覆盖默认值
                        if (config.server && config.server.port) {
                            appPort = config.server.port
                        }
                    } else {
                        echo "未找到 ${ymlFile}，使用默认端口 ${appPort}"
                    }
                    echo "解析到的实际端口为: ${appPort}"

                    // 开始传输文件
                    echo "开始传输 JAR 包和 Dockerfile 到云端..."
                    sh "ssh ${REMOTE_HOST} 'mkdir -p ${REMOTE_DIR}/${APP_NAME}'"
                    sh "scp ${APP_NAME}/target/${APP_NAME}.jar ${REMOTE_HOST}:${REMOTE_DIR}/${APP_NAME}/"
                    sh "scp ${APP_NAME}/Dockerfile ${REMOTE_HOST}:${REMOTE_DIR}/${APP_NAME}/"

                    echo "开始远端构建镜像并启动..."
                    sh """
                        ssh -T ${REMOTE_HOST} << 'ENDSSH'
set -e
APP_NAME="${APP_NAME}"
APP_PORT="${appPort}"
TARGET_DIR="${REMOTE_DIR}/${APP_NAME}"

cd \$TARGET_DIR

echo "1. 远端构建镜像..."
docker build -t \$APP_NAME:latest .

echo "2. 替换旧容器..."
docker stop \$APP_NAME || true
docker rm \$APP_NAME || true

echo "3. 启动新服务..."
docker run -d \\
  --name \$APP_NAME \\
  --restart always \\
  --network pajamas \\
  -e TZ=Asia/Shanghai \\
  -e SERVER_PORT=\$APP_PORT \\
  -p \$APP_PORT:\$APP_PORT \\
  \$APP_NAME:latest

echo "4. 清理无用缓存..."
docker image prune -f
ENDSSH
                    """
                }
            }
        }
    }
}