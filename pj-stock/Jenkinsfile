pipeline {
    agent any

    tools {
        maven 'Maven 3.9.10'
        jdk 'JDK 11'
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        APP_NAME = 'pj-stock'
        IMAGE_VERSION = "${BUILD_NUMBER}"
        // 阿里云 ACR 配置
        ACR_REGISTRY = 'crpi-acs8tzfyl1yty8iw.cn-hangzhou.personal.cr.aliyuncs.com'
        ACR_NAMESPACE = 'study-in-pj'
        ACR_REPO = "${ACR_REGISTRY}/${ACR_NAMESPACE}/${APP_NAME}"
        ACR_USER = 'aliyun8665615964'
        ACR_PASS = '@LiPengJie206714'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('checkout') {
            steps {
                echo '拉取最新代码...'
                git url: 'git@github.com:pajamas-pj/study-in-pajamas.git', branch: 'master'
            }
        }

        stage('build') {
            steps {
                echo "开始构建 ${APP_NAME} 模块..."
                sh "mvn clean package -pl ${APP_NAME} -am -DskipTests"
            }
            post {
                success {
                    echo "${APP_NAME} 模块打包成功！"
                    archiveArtifacts artifacts: "${APP_NAME}/target/*.jar", allowEmptyArchive: true
                }
                failure {
                    echo "${APP_NAME} 模块打包失败，请查日志！"
                }
            }
        }

        stage('build & push Image') {
            steps {
                // 在本地 Jenkins 构建镜像
                dir("${APP_NAME}") {
                    echo "1. 构建 Docker 镜像..."
                    // 此时用的是你本地电脑的 Docker 引擎
                    sh "docker build -t ${ACR_REPO}:${IMAGE_VERSION} ."

                    echo "2. 登录阿里云镜像仓库..."
                    sh "docker login -u ${ACR_USER} -p ${ACR_PASS} ${ACR_REGISTRY}"

                    echo "3. 推送镜像到阿里云..."
                    sh "docker push ${ACR_REPO}:${IMAGE_VERSION}"
                    echo " 同时给它打个 latest 标签，方便以后直接拉取"
                    sh "docker tag ${ACR_REPO}:${IMAGE_VERSION} ${ACR_REPO}:latest"
                    sh "docker push ${ACR_REPO}:latest"
                }
            }
        }

        stage('deploy remote') {
            steps {
                script {
                    def remoteHost = 'root@118.178.172.169'
                    sh """
                        echo '正在通知远程服务器拉取镜像并重启...'
                        # 这里是唯一跨网络的一步，通过 SSH 让远端服务器执行指令
                        ssh -T ${remoteHost} << 'ENDSSH'
set -e
APP_NAME="${APP_NAME}"
IMAGE_VERSION="${IMAGE_VERSION}"
ACR_REGISTRY="${ACR_REGISTRY}"
ACR_REPO="${ACR_REPO}"
ACR_USER="${ACR_USER}"
ACR_PASS="${ACR_PASS}"

echo "1. 登录仓库..."
docker login -u \$ACR_USER -p "\$ACR_PASS" \$ACR_REGISTRY

echo "2. 拉取最新镜像..."
docker pull \$ACR_REPO:\$IMAGE_VERSION

echo "3. 停止并删除旧容器..."
docker stop \$APP_NAME || true
docker rm \$APP_NAME || true

echo "4. 启动新容器..."
docker run -d \
  --name \$APP_NAME \
  --restart always \
  --network pajamas \
  -e TZ=Asia/Shanghai \
  -p 10010:10010 \
  \$ACR_REPO:\$IMAGE_VERSION

echo "5. 清理未被使用的旧镜像（释放磁盘空间）..."
docker image prune -f

echo "镜像化部署成功！"
ENDSSH
                    """
                }
            }
        }
    }
}