pipeline {
    // 单机部署，直接跑在 Master 上即可
    agent any

    tools {
        maven 'Maven 3.9.10'   // 确保在 Jenkins 全局工具配置中已添加
        jdk 'JDK 11'           // 对应 lts-jdk21 镜像内的 JDK
    }

    environment {
        APP_NAME = 'pj-user'
        APP_PORT = '8081'

        // ACR 配置
        ACR_REGISTRY = 'crpi-acs8tzfyl1yty8iw-vpc.cn-hangzhou.personal.cr.aliyuncs.com'
        ACR_NAMESPACE = 'study-in-pj'
        FULL_IMAGE_NAME = "${ACR_REGISTRY}/${ACR_NAMESPACE}/${APP_NAME}"

        IMAGE_TAG = 'latest'
        CREDENTIALS_ID = 'aliyun-acr-creds'
        TARGET_NETWORK = 'pajamas'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '3')) // 保留最近3次日志以便排查
        disableConcurrentBuilds() // 防止并发构建导致容器冲突（重要！）
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📥 拉取最新代码...'
                git url: 'git@github.com:pajamas-pj/study-in-pajamas.git',
                    branch: 'master'
            }
        }

        stage('Build & Package JAR') {
            steps {
                echo "⚙️ Maven 构建..."
                sh "mvn clean package -pl ${APP_NAME} -am -T 1C -DskipTests"
            }
        }

        stage('Build Docker Image & Push') {
            steps {
                script {
                    dir("${APP_NAME}") {
                        // 1. 登录 ACR
                        withCredentials([usernamePassword(credentialsId: env.CREDENTIALS_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh '''
                                set -e
                                echo "$DOCKER_PASS" | docker login --username="$DOCKER_USER" --password-stdin "${ACR_REGISTRY}"
                            '''
                        }

                        // 2. 构建镜像 (打上 latest 标签)
                        echo "🐳 构建 Docker 镜像: ${FULL_IMAGE_NAME}:latest"
                        sh "docker build -t ${FULL_IMAGE_NAME}:latest ."                        // 3. 推送到阿里云
                        echo "🚀 推送 latest 到 ACR..."
                        sh "docker push ${FULL_IMAGE_NAME}:latest"

                        // 4. 登出并清理本地缓存的 Auth (可选，为了安全)
                        sh "docker logout ${ACR_REGISTRY}"
                    }
                }
            }
        }

        stage('Deploy to Local Server') {
            steps {
                script {
                    echo "🚢 正在使用【本地已构建镜像】部署到本机..."
                    sh """
                        set -e

                        # 1. 停止并删除旧容器 (如果存在)
                        echo ">>> 停止旧容器 ${APP_NAME}..."
                        docker stop ${APP_NAME} || true
                        docker rm ${APP_NAME} || true

                        # 2. 启动新容器
                        echo ">>> 启动新容器 (使用本地 latest 镜像)..."
                        docker run -d \\
                          --name ${APP_NAME} \\
                          --restart always \\
                          --network ${TARGET_NETWORK} \\
                          -p ${APP_PORT}:${APP_PORT} \\
                          -e TZ=Asia/Shanghai \\
                          ${FULL_IMAGE_NAME}:latest

                        # 3. 简单健康检查
                        sleep 5
                        if [ "\$(docker ps -q -f name=${APP_NAME})" ]; then
                            echo "✅ 容器运行正常!"
                            docker logs ${APP_NAME} --tail 10
                        else
                            echo "❌ 容器启动失败!"
                            docker logs ${APP_NAME}
                            exit 1
                        fi
                    """
                }
            }
        }

        stage('Cleanup Unused Images') {
            steps {
                // 既然是 all-latest，旧的 latest 在被新 latest 覆盖前会被标记为 <none>
                // 这一步清理那些悬空的旧镜像，释放磁盘
                sh "docker image prune -f"
            }
        }
    }

    post {
        success {
            echo '🎉 Pipeline 执行成功! App is Live.'
        }
        failure {
            echo '💥 Pipeline 失败!'
        }
    }
}