pipeline {
    agent any

    tools {
        maven 'Maven 3.9.10'
        jdk 'JDK 11'
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        APP_NAME = 'pj-pay'
        MODULE_PATH = 'pj-pay/pj-pay-service'
        APP_PORT = '8088'

        REMOTE_HOST = 'root@118.178.172.169'
        REMOTE_DIR = '/opt/developments'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '3'))
    }

    stages {
        stage('checkout') {
            steps {
                echo '拉取代码...'
                git url: 'git@github.com:pajamas-pj/study-in-pajamas.git', branch: 'master'
            }
        }

        stage('build') {
            steps {
                echo "开始构建 ${MODULE_PATH} ..."
                // 👇 构建时使用 MODULE_PATH
                sh "mvn clean package -pl ${MODULE_PATH} -am -T 1C -Dmaven.test.skip=true -nsu"
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def appPort = "${APP_PORT}"
                    def ymlFile = "${MODULE_PATH}/src/main/resources/bootstrap.yml"

                    if (fileExists(ymlFile)) {
                        try {
                            def config = readYaml file: ymlFile
                            if (config.server && config.server.port) {
                                appPort = config.server.port
                            }
                        } catch (Exception e) {
                            echo "读取 yml 失败，使用默认端口 ${appPort} (请检查是否安装了 Pipeline Utility Steps 插件)"
                        }
                    } else {
                        echo "未找到 ${ymlFile}，使用默认端口 ${appPort}"
                    }
                    echo "解析到的实际端口为: ${appPort}"

                    echo "开始传输 JAR 包和 Dockerfile 到云端..."
                    // 1. 确保远端目录存在 (目录名用 APP_NAME 即 pj-pay)
                    sh "ssh ${REMOTE_HOST} 'mkdir -p ${REMOTE_DIR}/${APP_NAME}'"

                    // 2. 统一 JAR 包名字（防止带着版本号或服务名）
                    // 这里去 MODULE_PATH 下找到真实的 jar 包，重命名为 pj-pay.jar
                    sh "mv ${MODULE_PATH}/target/*.jar ${MODULE_PATH}/target/${APP_NAME}.jar || true"

                    // 3. 传输 JAR 和 Dockerfile
                    sh "scp ${MODULE_PATH}/target/${APP_NAME}.jar ${REMOTE_HOST}:${REMOTE_DIR}/${APP_NAME}/"
                    sh "scp ${MODULE_PATH}/Dockerfile ${REMOTE_HOST}:${REMOTE_DIR}/${APP_NAME}/"

                    echo "开始远端构建镜像并启动..."
                    sh """
                        ssh -T ${REMOTE_HOST} << 'ENDSSH'
set -e
APP_NAME="${APP_NAME}"
APP_PORT="${appPort}"
TARGET_DIR="${REMOTE_DIR}/${APP_NAME}"

cd \$TARGET_DIR

echo "1. 远端构建镜像..."
# 因为本地传输时已经重命名为 pj-pay.jar，这里直接用 latest
docker build -t \$APP_NAME:latest .

echo "2. 替换旧容器..."
docker stop \$APP_NAME || true
docker rm \$APP_NAME || true

echo "3. 启动新服务..."
docker run -d \\
  --name \$APP_NAME \\
  --restart always \\
  --network pajamas \\
  -e TZ=Asia/Shanghai \\
  -e SERVER_PORT=\$APP_PORT \\
  -p \$APP_PORT:\$APP_PORT \\
  \$APP_NAME:latest

echo "4. 清理无用缓存..."
docker image prune -f
ENDSSH
                    """
                }
            }
        }
    }
}