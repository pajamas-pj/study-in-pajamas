pipeline {
    agent any

    tools {
        maven 'Maven 3.9.10'
        jdk 'JDK 11'
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
        APP_NAME = 'pj-gateway'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('checkout') {
            steps {
                echo '拉取最新代码...'
                git url: 'git@github.com:pajamas-pj/study-in-pajamas.git', branch: 'master'
            }
        }

        stage('build') {
            steps {
                echo "开始构建 ${APP_NAME} 模块..."
                sh "mvn clean package -pl ${APP_NAME} -am -DskipTests"
            }
            post {
                success {
                    echo "${APP_NAME} 模块打包成功！"
                    archiveArtifacts artifacts: "${APP_NAME}/target/*.jar", allowEmptyArchive: true
                }
                failure {
                    echo "${APP_NAME} 模块打包失败，请查日志！"
                }
            }
        }

        stage('deploy') {
            steps {
                script {
                    def remoteHost = 'root@118.178.172.169'
                    // 每个服务独立一个目录
                    def deployPath = "/opt/developments/${APP_NAME}"
                    def jarFile = "${APP_NAME}.jar"
                    // 动态版本号，例如：pj-gateway:15
                    def imageVersion = "${BUILD_NUMBER}"

                    sh """
                        echo '正在上传 ${jarFile}...'

                        # 1. 确保远程专属目录存在
                        ssh ${remoteHost} "mkdir -p ${deployPath}"

                        # 2. 上传 JAR 包
                        scp -O ${APP_NAME}/target/${jarFile} ${remoteHost}:${deployPath}/

                        # 3. 上传 Dockerfile
                        scp -O ${APP_NAME}/Dockerfile ${remoteHost}:${deployPath}/

                        echo '正在远程通过 Docker 部署...'

                        # 4. 远程执行 Docker 替换命令
                        ssh -T ${remoteHost} << 'ENDSSH'
set -e
DEPLOY_PATH="${deployPath}"
APP_NAME="${APP_NAME}"
IMAGE_VERSION="${imageVersion}"

echo "进入目录 \$DEPLOY_PATH"
cd \$DEPLOY_PATH

echo "1. 开始构建 Docker 镜像..."
echo " 构建指定版本的镜像：\$APP_NAME:\$IMAGE_VERSION"
docker build -t \$APP_NAME:\$IMAGE_VERSION .
echo " 同时给它打个 latest 标签，方便以后直接拉取"
docker tag \$APP_NAME:\$IMAGE_VERSION \$APP_NAME:latest

echo "2. 停止并删除旧容器..."
docker stop \$APP_NAME || true
docker rm \$APP_NAME || true

echo "3. 使用新镜像启动容器..."
# 这里加上了时区设置 -e TZ=Asia/Shanghai
docker run -d \
  --name \$APP_NAME \
  --restart always \
  --network pajamas \
  -e TZ=Asia/Shanghai \
  -p 10010:10010 \
  \$APP_NAME:\$IMAGE_VERSION

echo "镜像化部署成功！"
ENDSSH
                    """
                }
            }
        }
    }
}